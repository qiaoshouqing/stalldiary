# PostgreSQL connection string used by local scripts and Worker fallback.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional: protects the AI / automation write endpoint.
AGENT_WRITE_TOKEN=replace-with-a-long-random-token

# Optional: enables the code contribution heatmap.
GITHUB_LOGIN=your-github-login
GITHUB_TOKEN=replace-with-a-github-token
